#!/bin/bash
# ==============================================================================
# Slurm 批次排程範本：Nano4 單節點多執行緒運算 (Single-Node Multi-Threading)
# 適用於：Python (multiprocessing)、R、FastQC、BWA、Samtools 等常規科研計算
# ==============================================================================
#SBATCH --account=GOV115088                  # 必填：wallet 查詢之可用計畫代號 (生醫: GOV115088)
#SBATCH --job-name=cpu_task                  # 作業識別名稱
#SBATCH --partition=ngs62g                   # Nano4 生醫佇列 (上限 8 核心、62GB 記憶體)
#SBATCH --nodes=1                            # 單節點運算
#SBATCH --ntasks-per-node=1                  # 節點內主行程數
#SBATCH --cpus-per-task=4                    # 分配 CPU 核心數 (ngs62g 上限 8)
#SBATCH --mem=16G                            # 【關鍵】分配記憶體大小 (ngs62g 上限 62G)
#SBATCH --time=01:00:00                      # 作業最長時限 (D-HH:MM:SS)
#SBATCH --output=%x-%j.out                   # 標準輸出 (%x:作業名, %j:作業ID)
#SBATCH --error=%x-%j.err                    # 標準錯誤
#SBATCH --mail-type=END,FAIL                 # 通知時機 (NONE / BEGIN / END / FAIL / ALL)
##SBATCH --mail-user=user@example.com        # 接收通報之 Email

# ------------------------------------------------------------------------------
# 嚴格安全與環境設定
# ------------------------------------------------------------------------------
set -euo pipefail

echo "================================================================================"
echo "作業啟動時間 : $(date)"
echo "執行計算節點 : $(hostname -s)"
echo "作業任務 ID  : ${SLURM_JOB_ID}"
echo "分配 CPU 核心: ${SLURM_CPUS_PER_TASK}"
echo "分配記憶體   : ${SLURM_MEM_PER_NODE:-'未指定'} MB"
echo "工作目錄     : $(pwd)"
echo "================================================================================"

# ------------------------------------------------------------------------------
# 載入運算環境與模組
# ------------------------------------------------------------------------------
module purge 2>/dev/null || true

# 啟用 Python 虛擬環境 (建議建於 /work/$USER/.venv)
# source /work/$USER/.venv/bin/activate

# ------------------------------------------------------------------------------
# 執行核心運算任務
# ------------------------------------------------------------------------------
# python3 my_script.py --threads ${SLURM_CPUS_PER_TASK}

echo "================================================================================"
echo "作業完成時間 : $(date)"
echo "效能分析請執行: seff ${SLURM_JOB_ID}"
echo "================================================================================"

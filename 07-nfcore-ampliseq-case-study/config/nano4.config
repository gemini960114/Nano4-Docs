// Nano4 infrastructure settings only. Pipeline parameters belong on the CLI or in
// a params file, not in this file.

def nfcoreAccount = System.getenv('NFCORE_ACCOUNT')
def nfcorePartition = System.getenv('NFCORE_PARTITION')

if (!nfcoreAccount) {
    throw new IllegalArgumentException('NFCORE_ACCOUNT is required')
}
if (!nfcorePartition) {
    throw new IllegalArgumentException('NFCORE_PARTITION is required')
}

process {
    executor = 'slurm'
    queue = nfcorePartition
    clusterOptions = "--account=${nfcoreAccount}"
    resourceLimits = [
        cpus: 8,
        memory: 62.GB,
        time: 96.h
    ]
}

executor {
    queueSize = 10
    submitRateLimit = '2 sec'
}

singularity {
    enabled = true
    autoMounts = true
}

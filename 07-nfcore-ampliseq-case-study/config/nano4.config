// Nano4 course overrides only. Pipeline parameters belong on the CLI or in a
// params file, not in this file.
//
// Load order (last -c wins):
//   -c "${NFCORE_SITE_CONFIG}"   central NCHC site config (containers, retries)
//   -c config/nano4.config       this file: pin every process to one partition
//
// The central site.config picks a partition per task (ngs8g, ngs16g, ...).
// Course projects such as GOV115088 are only allowed on ngs62g, so this file
// replaces that routing with the partition passed in NFCORE_PARTITION.

def nfcoreAccount = System.getenv('NFCORE_ACCOUNT')
def nfcorePartition = System.getenv('NFCORE_PARTITION')

if (!nfcoreAccount) {
    throw new IllegalArgumentException('NFCORE_ACCOUNT is required')
}
if (!nfcorePartition) {
    throw new IllegalArgumentException('NFCORE_PARTITION is required')
}

process {
    executor = 'slurm'
    queue = nfcorePartition
    clusterOptions = "--account=${nfcoreAccount}"
    // ngs62g QoS: at most 8 CPU and 62 GB per job, 4 days wall time.
    resourceLimits = [
        cpus: 8,
        memory: 62.GB,
        time: 96.h
    ]

    // site.config re-routes this label with its own selector; pin it as well.
    withLabel: process_high_memory {
        queue = nfcorePartition
    }

    // NCHC GP1 rule: each partition must be requested with its fixed CPU/memory
    // pairing (ngs62g: -c 8 --mem=62G). withName outranks every withLabel, so this
    // applies to all pipeline processes regardless of their nf-core label.
    withName: '.*' {
        cpus = 8
        memory = 62.GB
    }
}

executor {
    queueSize = 10
    submitRateLimit = '2 sec'
}

singularity {
    enabled = true
    autoMounts = true
}
